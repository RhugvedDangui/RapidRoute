# ──────────────────────────────────────────────────────────────────────────────
# AI Agent — Environment Variables
# Copy this file to .env and fill in all values before running the server.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM: OpenCode Zen / Big Pickle (free during feedback period) ──────────────
# Get your key at: https://opencode.ai/zen
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=big-pickle

# ── Tavily Web Search (free: 1 000 searches / month) ─────────────────────────
# Sign up at: https://tavily.com
TAVILY_API_KEY=

# ── Qdrant Cloud Vector DB (free: 1 GB cluster) ───────────────────────────────
# Create a free cluster at: https://cloud.qdrant.io
QDRANT_URL=https://<cluster-id>.aws.cloud.qdrant.io
QDRANT_API_KEY=

# ── Upstash Redis (free: 10 000 commands / day) ───────────────────────────────
# Create a free database at: https://upstash.com
UPSTASH_REDIS_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_TOKEN=

# ── mem0 Long-Term Memory (free tier) ────────────────────────────────────────
# Sign up at: https://app.mem0.ai
MEM0_API_KEY=

# ── Langfuse Tracing (free cloud tier) ───────────────────────────────────────
# Sign up at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Supabase Database (optional) ──────────────────────────────────────────────
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
# Leave empty if you don't want database access
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_KEY=<your-anon-or-service-role-key>

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# LLM_MODEL=opencode/big-pickle
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# QDRANT_COLLECTION=agent_knowledge
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# SESSION_HISTORY_LIMIT=20
# SESSION_TTL_SECONDS=7200
# LONG_TERM_TOP_K=5
